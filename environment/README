## Analysis job submittion
# copy the run_pipeline.sh file to edit
cp /home/jflucier/projects/def-labolcf/programs/phage-genome-analysis-pipeline/environment/run_pipeline.sh /lustre06/project/def-labolcf/labolcf/<</path/to/analysis/folder>>

# edit lines 14 and 15 with right path of
vi /lustre06/project/def-labolcf/labolcf/<</path/to/analysis/folder>>/run_pipeline.sh

# let say data folder is in /lustre06/project/def-labolcf/labolcf/<</path/to/analysis/folder>>/data
total_job_nbr=$(ls -d /lustre06/project/def-labolcf/labolcf/<</path/to/analysis/folder>>/data/* | wc -l)
echo "Total jobs to submit = ${total_job_nbr}"

# for test purpose first start a single job to make sure it all goes well
sbatch --array=1 /lustre06/project/def-labolcf/labolcf/<</path/to/analysis/folder>>/run_pipeline.sh

