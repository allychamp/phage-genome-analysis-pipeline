## Cluster environment creation: no need to run on narval
# pharokka
module purge && module load StdEnv/2020 python/3.10.2 gcc/9.3.0 java/17.0.2 blast+/2.10.1 diamond/0.9.36 mcl/14.137
mkdir /home/jflucier/projects/def-labolcf/programs/phage-genome-analysis-pipeline/venv
virtualenv --no-download /home/jflucier/projects/def-labolcf/programs/phage-genome-analysis-pipeline/venv/pharokka_venv
source /home/jflucier/projects/def-labolcf/programs/phage-genome-analysis-pipeline/venv/pharokka_venv/bin/activate
pip install pharokka
install_databases.py -d
deactivate

# phold
